---
pagination:
  data: hub.resources
  size: 1
  alias: r
permalink: "/r/{{ r.id }}/"
eleventyComputed:
  title: "{{ r.title | safe }} | DN Design Hub"
  description: "{{ r.description | metaDesc | safe }}"
  ogImage: "{{ r.thumbnail }}"
  ogImageAlt: "{{ r.title | safe }}"
  ogType: article
---
{#- One page per resource: a shareable URL with its own social card, and
    the page AI answer engines cite. The id in data.js is its URL slug, so
    renaming an id breaks its link. -#}
{% extends "base.njk" %}
{%- set tc = hub.types[r.type] -%}
{%- set isDl = r.type == "download" -%}
{%- set firstTopic = hub.tags[r.tags[0]] -%}

{% block jsonld %}
<script type="application/ld+json">{{ r | schemaResource(hub) | jsonld | safe }}</script>
{% endblock %}

{% block hero %}
<header class="hero hero--page">
  <canvas class="topo-canvas" data-topo-motion aria-hidden="true"></canvas>
  <div class="topo-overlay"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Hub</a></li>
        <li><a href="/topics/{{ r.tags[0] }}/">{{ firstTopic.label }}</a></li>
        <li aria-current="page">{{ r.title }}</li>
      </ol>
    </nav>
    <span class="eyebrow">{{ tc.label }}{% if r.source %} &middot; {{ r.source }}{% endif %}</span>
    <h1>{{ r.title }}</h1>
    <p class="lede">{{ r.description }}</p>
    <div class="btn-row btn-row--start">
      {#- The resource is the page's main action, in Warm White: the one
          orange on the page stays the rail's LinkedIn CTA (CLAUDE.md §6) -#}
      <a class="btn-cta btn-cta--light" href="{{ r.url | url }}"{% if isDl %} download{% else %} target="_blank"{% endif %} rel="noopener">
        {%- if isDl %}Download <span class="arrow arrow--down" aria-hidden="true">&darr;</span>
        {%- else %}Open {{ r.url | host or "resource" }} <span class="arrow arrow--out" aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in a new tab)</span>{% endif -%}
      </a>
      <a class="btn-cta btn-cta--outline" href="/#archive">Browse the archive <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</header>
{% endblock %}

{% block content %}
    <section class="section resource-detail{% if not r.related.length %} section--flush{% endif %}">
      {%- if r.thumbnail %}
      <figure class="resource-shot"><img src="{{ r.thumbnail | url }}" alt=""></figure>
      {%- endif %}
      <h2 class="sr-only">Details</h2>
      <dl class="facts">
        <div><dt>Format</dt><dd><span class="icon">{{ tc.icon | icon | safe }}</span>{{ tc.label }}</dd></div>
        {%- if r.source %}<div><dt>From</dt><dd>{{ r.source }}</dd></div>{% endif %}
        <div><dt>Added</dt><dd><time datetime="{{ r.dateAdded }}">{{ r.dateAdded | fmtDate }}</time></dd></div>
        <div><dt>Topics</dt><dd class="pill-row pill-row--flush">
          {%- for t in r.tags %}<a class="pill" href="/topics/{{ t }}/" title="{{ hub.tags[t].desc }}">{{ hub.tags[t].label }}</a>{% endfor -%}
        </dd></div>
        <div><dt>Link</dt><dd><a class="text-link" href="{{ r.url | url }}"{% if isDl %} download{% else %} target="_blank"{% endif %} rel="noopener">
          {{- r.url | host if (r.url | host) else (r.url | url) }}</a></dd></div>
      </dl>
    </section>

    {%- if r.related.length %}
    <section class="section section--flush">
      <div class="section-head">
        <span class="eyebrow">Also in {{ firstTopic.label }}</span>
        <h2>More like this.</h2>
      </div>
      <div class="artifact-grid">
        {%- for a in r.related %}
        {% include "card.njk" %}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}
{% endblock %}
