<!-- Below the rail breakpoint, a slim strip puts the curator and the CTA on screen early -->
<div class="bio-strip">
  <img class="bio-strip__img" src="/assets/img/dan-avatar.jpg" alt="" width="48" height="48">
  <p class="bio-strip__text"><b>{{ site.person.name }}</b>Curating what's worth keeping for design, UX and AI work.</p>
  <a class="btn-cta btn-cta--sm" href="{{ site.person.linkedin }}" target="_blank" rel="noopener">LinkedIn <span class="arrow arrow--out" aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in a new tab)</span></a>
</div>
