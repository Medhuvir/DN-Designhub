{#- A resource's thumbnail. Expects `a` (resource) and optionally `sizes`.
    Uses the build's responsive set (src/_data/images.js) when it has one. -#}
{%- set img = images[a.id] -%}
{%- if img -%}
<picture>
  <source type="image/webp" srcset="{{ img.webp }}" sizes="{{ sizes or '(min-width: 1100px) 440px, (min-width: 640px) 45vw, 100vw' }}">
  <img src="{{ img.src }}" srcset="{{ img.jpeg }}" sizes="{{ sizes or '(min-width: 1100px) 440px, (min-width: 640px) 45vw, 100vw' }}" width="{{ img.width }}" height="{{ img.height }}" alt="" loading="lazy" decoding="async">
</picture>
{%- else -%}
<img src="{{ a.thumbnail | url }}" alt="" loading="lazy" decoding="async">
{%- endif -%}
