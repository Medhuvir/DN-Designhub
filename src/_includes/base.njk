{#- Shared shell for every page. Pages set: title, description, (optional)
    ogImage/ogImageAlt/ogType, noindex, and fill the hero/content blocks.
    Every URL is root-absolute so nested pages (/r/…, /topics/…) work. -#}
{%- set isHome = page.url == "/" -%}
{%- set nav = "" if isHome else "/" -%}
{%- set pageTitle = title or (site.title + " | " + site.name) -%}
{%- set pageDesc = description or site.description -%}
{%- set canonical = site.url + page.url -%}
{%- set shareImage = (ogImage or site.ogImage) | absUrl -%}
{%- set shareAlt = ogImageAlt or site.ogImageAlt -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ shareImage }}">
{%- if not ogImage %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif %}
<meta property="og:image:alt" content="{{ shareAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ shareImage }}">
<meta name="twitter:image:alt" content="{{ shareAlt }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}: new resources" href="/feed.xml">
{%- endif %}
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="stylesheet" href="/assets/css/hub.css">
{%- block jsonld %}{% endblock %}
</head>
<body{% if isHome %} class="page-home"{% endif %}>
<a class="skip-link" href="#main">Skip to content</a>

<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <div class="lockup-group">
      <a href="/" class="brand-lockup">
        <img src="/assets/img/dn-mark-white.svg" alt="" class="mark">
        <span class="brand-divider"></span>
        <span>
          <span class="brand-word">DN Creative</span>
          <span class="brand-sub">Design Studio</span>
        </span>
      </a>
      <span class="hub-title-inline">Design Hub</span>
    </div>
    {% set sid = "nav" %}{% set searchClass = "search--nav" %}{% include "search.njk" %}
    <div class="nav-links">
      <a href="{{ nav }}#featured">Featured</a>
      <a href="{{ nav }}#archive">Archive</a>
      <a href="{{ nav }}#about">About</a>
    </div>
    {%- if heroCta %}
    {#- Hands off from the hero's Follow button once it scrolls away (main.js),
        so exactly one orange button is ever in view -#}
    <a class="btn-cta btn-cta--sm nav-follow" href="{{ site.person.linkedin }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">Follow <span class="arrow arrow--out" aria-hidden="true">&nearr;</span><span class="sr-only"> Dan on LinkedIn (opens in a new tab)</span></a>
    {%- endif %}
    <button class="hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </div>
</nav>

<div class="mobile-panel" id="mobile-menu">
  {% set sid = "menu" %}{% set searchClass = "search--menu" %}{% include "search.njk" %}
  <a href="{{ nav }}#featured">Featured</a>
  <a href="{{ nav }}#archive">Archive</a>
  <a href="{{ nav }}#about">About</a>
  <div class="mp-meta">A running archive by Dan Nemirovsky, DN Creative</div>
</div>

<main id="main">
{%- block main %}
{% block hero %}{% endblock %}

<div class="wrap hub-layout">
  <div class="hub-main">
    {% if bioStrip !== false %}{% include "bio-strip.njk" %}{% endif %}
    {% block content %}{% endblock %}
  </div>
  {% include "rail.njk" %}
</div>
{%- endblock %}
</main>

{% block footer %}
{#- Footer: gray topo (the generator, desaturated in CSS) behind the DN mark
    and the copyright, nothing else. Dan's call, Nov 21, 2026. -#}
<footer class="site-footer">
  <canvas class="topo-canvas topo-canvas--gray" data-topo-motion aria-hidden="true"></canvas>
  <div class="footer-shade" aria-hidden="true"></div>
  <div class="wrap footer-inner">
    <a class="footer-mark" href="{{ site.org.url }}" target="_blank" rel="noopener"><img src="/assets/img/dn-mark-white.svg" alt="" width="40" height="44"><span class="sr-only">DN Creative Studio (opens in a new tab)</span></a>
    <p class="footer-copy">&copy; <span id="footer-year">{{ site.year }}</span> DN Creative. All rights reserved.</p>
  </div>
</footer>
{% endblock %}

<script type="application/json" id="search-index">{{ hub.searchIndex | jsonld | safe }}</script>
<script src="/assets/js/topo-motion.js"></script>
<script src="/assets/js/main.js"></script>
</body>
</html>
